{
  "description": "Ledger Atlas bounded orchestration hooks. Inactive until explicitly armed.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/orchestrion.py\" session_start",
            "timeout": 5,
            "statusMessage": "Loading Ledger Atlas context",
            "additionalContextLimit": 6000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/orchestrion.py\" pre_tool_use",
            "timeout": 5,
            "statusMessage": "Checking Ledger Atlas policy"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/orchestrion.py\" stop",
            "timeout": 120,
            "statusMessage": "Checking the active Ledger Atlas goal gate"
          }
        ]
      }
    ]
  }
}
