# Project command policy for requests to run outside the sandbox.
# Hooks and the repository pre-commit attestation cover in-sandbox paths.

prefix_rule(
    pattern = ["git", "commit"],
    decision = "forbidden",
    justification = "Use ./scripts/gate-commit.sh after staged-diff verification and independent review.",
    match = ["git commit -m test", "git commit --amend"],
    not_match = ["git status", "git diff --cached"],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "Push is a separate human-authorized integration action.",
    match = ["git push", "git push origin main", "git push --force"],
)

prefix_rule(
    pattern = ["git", ["merge", "rebase"]],
    decision = "forbidden",
    justification = "Merge and rebase require explicit integration review outside an autonomous atom.",
    match = ["git merge atom/IMP-001", "git rebase main"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Preserve the audit trail and user-owned work; use a new change or recoverable worktree.",
    match = ["git reset --hard", "git reset --hard HEAD~1"],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "Do not delete untracked user data. Inspect exact targets and use a recoverable operation.",
    match = ["git clean -fd", "git clean -fdx"],
)

prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "forbidden",
    justification = "PR merge is an external integration action and requires explicit human authorization.",
    match = ["gh pr merge 123", "gh pr merge --squash 123"],
)

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "Ledger Atlas project automation must not request unrestricted privilege escalation.",
    match = ["sudo rm -rf /tmp/example", "sudo xcode-select --switch /Applications/Xcode.app"],
)

